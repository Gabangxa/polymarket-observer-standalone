# Stage 1: install dependencies
FROM node:24-slim AS deps
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@latest --activate
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY lib/api-client-react/package.json lib/api-client-react/
COPY lib/api-spec/package.json lib/api-spec/
COPY lib/api-zod/package.json lib/api-zod/
COPY artifacts/dashboard/package.json artifacts/dashboard/
RUN pnpm install --frozen-lockfile

# Stage 2: build
FROM deps AS build
WORKDIR /app
COPY lib/ lib/
COPY artifacts/dashboard/ artifacts/dashboard/
COPY tsconfig.base.json ./
RUN pnpm --filter @workspace/dashboard build

# Stage 3: serve with nginx + API proxy
FROM nginx:alpine
RUN apk add --no-cache gettext
COPY --from=build /app/artifacts/dashboard/dist/public /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
ENV API_SERVER_URL=http://localhost:8080
ENV PORT=80
EXPOSE 80
CMD ["/bin/sh", "-c", "export DNS_RESOLVER=$(awk '/^nameserver/{ip=$2; if(ip~/:/){ip=\"[\"ip\"]\"}; print ip; exit}' /etc/resolv.conf) && envsubst '${API_SERVER_URL} ${DNS_RESOLVER}' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]

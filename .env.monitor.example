# Copy to .env.monitor and fill in real values. .env.monitor is gitignored
# because it holds a DB password and the internal API key.
#
#   cp .env.monitor.example .env.monitor   # then edit

# Connection string to the Postgres the trading bot writes. Host is the
# bot-local db container name, reachable on the shared Docker network.
DATABASE_URL=postgresql://polymarket:CHANGE_ME@polymarket-bot-local-db-1:5432/polymarket

# Shared secret used for the API's internal auth.
INTERNAL_API_KEY=CHANGE_ME

# Where the dashboard's nginx proxies /api -> the api service on the shared
# network. Leave as-is unless you rename the api service.
API_SERVER_URL=http://api:8080

# Host port bindings.
API_PORT=8080
DASHBOARD_PORT=3000

# External Docker network shared with the bot-local stack (must already exist).
MONITOR_NETWORK=polymarket-bot-local_default

# ── Database ──────────────────────────────────────────────────────────────────
# When using docker-compose with the local db service:
DATABASE_URL=postgresql://polymarket:yourpassword@db:5432/polymarket
POSTGRES_PASSWORD=yourpassword

# When using an external DB (Supabase, Neon, Railway, etc.):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── API server ────────────────────────────────────────────────────────────────
PORT=8080
API_PORT=8080   # host port docker-compose maps to container 8080
